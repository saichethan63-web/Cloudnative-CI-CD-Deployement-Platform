# Copy to .env for local use:  cp .env.example .env
# On the server, scripts/platform-deploy.sh generates this file automatically.

APP_ENV=development
HTTP_PORT=8080            # use 80 on the server
SERVER_NAME=_             # your domain name, or _ to match any host
PUBLIC_HOST=localhost     # host name Grafana uses to build links
GRAFANA_ADMIN_PASSWORD=changeme-local-only
PROMETHEUS_RETENTION=15d

# Set by CI/CD on the server; leave unset locally to build from ./app
# APP_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/cloudnative-platform-prod-app:<sha>
